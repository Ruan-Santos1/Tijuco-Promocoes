{
  "expo": {
    "name": "Tijuco Promoções",
    "slug": "TijucoApp",
    "version": "1.2.0",
    "orientation": "portrait",
    "scheme": "tijuco",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.tijucopromocoes",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07172B",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.tijucopromocoes",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O Tijuco Promoções acessa suas fotos para você escolher a imagem da oferta.",
          "cameraPermission": "O Tijuco Promoções usa a câmera para você fotografar a oferta.",
          "microphonePermission": false
        }
      ]
    ]
  }
}